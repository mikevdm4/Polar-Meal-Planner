# Copy this file to .env.local for local development, or set these as
# Environment Variables in your Vercel project settings for deployment.
#
# Both values come from Supabase: Project Settings -> API
# The anon key is safe to expose in the browser bundle (Row Level Security
# in supabase/schema.sql controls what it can actually access).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
